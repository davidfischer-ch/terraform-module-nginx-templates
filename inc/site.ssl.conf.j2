    {% if ssl_use_directive|default(false) %}ssl on;{% endif %}

    ssl_certificate     sites-ssl/{{ name }}.crt;
    ssl_certificate_key sites-ssl/{{ name }}.key;

    # Modern TLS only - TLS 1.0/1.1 deprecated by RFC 8996 (2021).
    ssl_protocols TLSv1.2 TLSv1.3;

    # Mozilla "intermediate" cipher suite - AEAD only (GCM, ChaCha20-Poly1305).
    # https://ssl-config.mozilla.org/#server=nginx&config=intermediate
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # Session resumption. Disable tickets - a leaked ticket key compromises
    # forward secrecy retroactively across the lifetime of the key.
    ssl_session_cache   shared:SSL:50m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    {% if with_ocsp_stapling|default(false) %}
    # OCSP stapling - faster TLS handshake, no client-side CA phone-home.
    # Requires `resolver` at http scope (see nginx security.conf) and the cert
    # to carry an OCSP responder URL in its AIA extension. Let's Encrypt phased
    # out OCSP from issued certs in early 2025; not useful with LE-only setups.
    ssl_stapling on;
    ssl_stapling_verify on;
    {% endif %}

    {% if with_dhparam|default(true) %}
    # Diffie-Hellman parameter for DHE cipher suites, 2048 bits minimum.
    ssl_dhparam sites-dhparam/{{ name }}.pem;
    {% endif %}

    {% if with_hsts|default(true) %}
    # HSTS - 2 years + subdomains. Add `; preload` only once every *.{{ '{' }}domain{{ '}' }} is
    # HTTPS-only and submitted to https://hstspreload.org (irreversible commitment).
    # https://developer.mozilla.org/en-US/docs/Security/HTTP_Strict_Transport_Security
    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    {% endif %}
